# Copy to .env and fill in. Secrets are only ever read from the environment.

# Warehouse: path to the DuckDB file (relative paths resolve from the repo root).
WAREHOUSE_URL=data/caclens.duckdb

# Demo mode generates a synthetic dataset instead of calling source APIs.
CACLENS_DEMO=true

# --- FR-01 connectors -------------------------------------------------------
# Google Ads (REST searchStream)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# Meta Marketing API
META_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# LinkedIn Marketing API
LINKEDIN_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_API_VERSION=202409

# HubSpot private app token
HUBSPOT_TOKEN=
HUBSPOT_SEGMENT_PROPERTY=company_size

# Salesforce (OAuth client-credentials flow)
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v61.0

# Stripe restricted key with read access
STRIPE_KEY=
STRIPE_CRM_ID_METADATA_KEY=hubspot_contact_id

# Payroll / tool cost CSVs (see data/sample/*.csv for the format)
PAYROLL_CSV_PATH=
TOOL_COSTS_CSV_PATH=

# --- FR-07 Q&A ----------------------------------------------------------------
ANTHROPIC_API_KEY=
CACLENS_QA_MODEL=claude-opus-5-5

# --- FR-06 alerts -------------------------------------------------------------
CACLENS_ALERT_WINDOW_DAYS=14
CACLENS_ALERT_BASELINE_DAYS=56
CACLENS_ALERT_THRESHOLD_PCT=0.30
CACLENS_ALERT_MIN_CUSTOMERS=5

# --- Web ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
